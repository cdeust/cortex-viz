{
  "name": "cortex-viz-ui-tests",
  "version": "0.0.0",
  "private": true,
  "description": "JavaScript test harness for cortex-viz's browser UI (ui/). Vanilla ESM + jsdom under vitest; no bundler.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qs": "^6.17.1"
  }
}
