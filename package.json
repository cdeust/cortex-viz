{
  "name": "cortex-viz-ui-tests",
  "version": "0.0.0",
  "private": true,
  "description": "JavaScript test harness for cortex-viz's browser UI (ui/). Vanilla ESM + jsdom under vitest; no bundler.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^28.1.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
