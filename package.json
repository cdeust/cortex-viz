{
  "name": "cortex-viz-ui-tests",
  "version": "0.0.0",
  "private": true,
  "description": "JavaScript test harness for cortex-viz's browser UI (ui/). Vanilla ESM + jsdom under vitest; no bundler.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
